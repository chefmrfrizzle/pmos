PMOS_PRIVATE_ROOT=/path/outside/the/public/repository
PMOS_DB_URL=sqlite:////path/outside/the/public/repository/pmos.db
PMOS_USER_AGENT=PMOSResearch/0.1 (+your-email@example.com)
PMOS_REQUEST_DELAY_SECONDS=1.5
NEXT_PUBLIC_API_URL=http://localhost:8000
PMOS_AUTH_MODE=disabled
PMOS_TENANT_ID=example-tenant
PMOS_OIDC_ISSUER=https://identity.example/
PMOS_OIDC_AUDIENCE=pmos-private-api
PMOS_OIDC_JWKS_URL=https://identity.example/.well-known/jwks.json
PMOS_MAX_TOKEN_AGE_SECONDS=900
PMOS_MAX_AUTH_AGE_SECONDS=43200
PMOS_REVOKED_JTI_HASHES=
